    </TableRow>




    <!--     Row 8 Starts From Here . New in Version 1.3 -->
    <TableRow
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_weight="20">




        <Button
            android:id="@+id/buttonof"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/_off"
            android:textSize="30sp"
            android:background="@drawable/button_s"
            android:textColor="@drawable/button_text_colour"
            android:layout_span="1"
            android:typeface="monospace"
            />



        <Button
            android:id="@+id/buttoninterad"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/_Inter"
            android:textSize="30sp"
            android:background="@drawable/button_s"
            android:textColor="@drawable/button_text_colour"
            android:layout_span="1"
            android:typeface="monospace"
            />
        <Button
            android:id="@+id/buttonvedioad"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/_Vedio"
            android:textSize="30sp"
            android:background="@drawable/button_s"
            android:textColor="@drawable/button_text_colour"
            android:layout_span="1"
            android:typeface="monospace"/>

        <Button
            android:id="@+id/buttonskin"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/_Skins"
            android:textSize="30sp"
            android:background="@color/OperatorsBG"
            android:textColor="@color/pink"
            android:layout_span="1"
            android:typeface="monospace"
            />


    </TableRow>

    <!--     Row 9 Starts From Here -->
    <TableRow
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_weight="20">

        <TextView
            android:id="@+id/textViewLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_span="4"
            android:background="@color/colorPrimaryDark"
            android:textSize="20sp"
            android:textColor="@color/LinkColour"
            android:gravity="center_horizontal"/>

    </TableRow>
    <TableRow>

        <com.google.android.gms.ads.AdView
            android:id="@+id/banner_AdView"
            android:layout_width="wrap_content"
            android:layout_span="4"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            ads:adSize="BANNER"
            ads:adUnitId="@string/ad_id_banner" />

    </TableRow>


</TableLayout>